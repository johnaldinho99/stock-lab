# Kopiera till .env och fyll i. .env checkas aldrig in i git.

# Alpaca (paper trading-konto räcker): https://app.alpaca.markets -> Paper -> API Keys
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex = gratis realtidsflöde, sip = alla börser (kräver betald plan)
ALPACA_DATA_FEED=iex

# SEC kräver en User-Agent med kontaktuppgift: "Namn eller app epost@exempel.se"
SEC_USER_AGENT=stock-lab research tool admin@example.com
